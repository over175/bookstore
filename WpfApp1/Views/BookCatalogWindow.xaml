<Window x:Class="BookStoreWPF.Views.BookCatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Каталог книг" Height="600" Width="800"
        Background="{StaticResource PrimaryBackgroundBrush}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        
        <TextBlock Grid.Row="0" Text="Каталог книг" 
                  Style="{StaticResource HeaderTextStyle}"
                  HorizontalAlignment="Center" Margin="0,0,0,10"/>

       
        <StackPanel x:Name="controlPanel" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="txtSearch" Width="200" Margin="0,0,10,0"
                    TextChanged="TxtSearch_TextChanged"
                    Background="{StaticResource SecondaryBackgroundBrush}"
                    FontFamily="{StaticResource MainFont}"
                    FontSize="12"/>

            <ComboBox x:Name="cmbSort" Width="150" Margin="0,0,10,0"
                     SelectionChanged="CmbSort_SelectionChanged"
                     Background="{StaticResource SecondaryBackgroundBrush}"
                     FontFamily="{StaticResource MainFont}"
                     FontSize="12">
                <ComboBoxItem Content="По названию (А-Я)"/>
                <ComboBoxItem Content="По названию (Я-А)"/>
                <ComboBoxItem Content="По цене (возрастание)"/>
                <ComboBoxItem Content="По цене (убывание)"/>
            </ComboBox>

            <ComboBox x:Name="cmbFilter" Width="150"
                     SelectionChanged="CmbFilter_SelectionChanged"
                     Background="{StaticResource SecondaryBackgroundBrush}"
                     FontFamily="{StaticResource MainFont}"
                     FontSize="12">
                <ComboBoxItem Content="Все жанры"/>
                <ComboBoxItem Content="Классика"/>
                <ComboBoxItem Content="Роман"/>
                <ComboBoxItem Content="Фэнтези"/>
                <ComboBoxItem Content="Антиутопия"/>
            </ComboBox>
        </StackPanel>

        
        <DataGrid x:Name="booksGrid" Grid.Row="2"
                 AutoGenerateColumns="False"
                 IsReadOnly="True"
                 Background="{StaticResource PrimaryBackgroundBrush}"
                 FontFamily="{StaticResource MainFont}"
                 FontSize="12"
                 LoadingRow="BooksGrid_LoadingRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Автор" Binding="{Binding Author}" Width="200"/>
                <DataGridTextColumn Header="Жанр" Binding="{Binding Genre}" Width="150"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:C}}" Width="100"/>
                <DataGridTextColumn Header="Скидка" Binding="{Binding Discount, StringFormat={}{0}%}" Width="80"/>
                <DataGridTextColumn Header="Итоговая цена" Binding="{Binding FinalPrice, StringFormat={}{0:C}}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
