
<Window x:Class="BookStoreWPF.Views.OrderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование заказа" Height="350" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PrimaryBackgroundBrush}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

       
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Редактирование заказа" 
                  Style="{StaticResource HeaderTextStyle}"
                  HorizontalAlignment="Center" Margin="0,0,0,15"/>

        
        <TextBlock Grid.Row="1" Grid.Column="0" Text="ID пользователя:" 
                  Style="{StaticResource MainTextStyle}" Margin="0,5"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtUserId" 
                Background="{StaticResource SecondaryBackgroundBrush}"
                FontFamily="{StaticResource MainFont}" Margin="5"/>

        
        <TextBlock Grid.Row="2" Grid.Column="0" Text="ID книги:" 
                  Style="{StaticResource MainTextStyle}" Margin="0,5"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtBookId" 
                Background="{StaticResource SecondaryBackgroundBrush}"
                FontFamily="{StaticResource MainFont}" Margin="5"/>

        
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Количество:" 
                  Style="{StaticResource MainTextStyle}" Margin="0,5"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtQuantity" 
                Background="{StaticResource SecondaryBackgroundBrush}"
                FontFamily="{StaticResource MainFont}" Margin="5"/>

       
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Статус:" 
                  Style="{StaticResource MainTextStyle}" Margin="0,5"/>
        <ComboBox Grid.Row="4" Grid.Column="1" x:Name="cmbStatus" 
                 Background="{StaticResource SecondaryBackgroundBrush}"
                 FontFamily="{StaticResource MainFont}" Margin="5">
            <ComboBoxItem Content="В обработке"/>
            <ComboBoxItem Content="Выполнен"/>
            <ComboBoxItem Content="Отменен"/>
        </ComboBox>

        
        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" 
                   HorizontalAlignment="Center" Margin="0,15">
            <Button x:Name="btnSave" Content="Сохранить" Click="BtnSave_Click"
                    Style="{StaticResource AccentButtonStyle}"/>
            <Button x:Name="btnCancel" Content="Отмена" Click="BtnCancel_Click"
                    Style="{StaticResource AccentButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>