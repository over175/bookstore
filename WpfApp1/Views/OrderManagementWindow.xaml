
<Window x:Class="BookStoreWPF.Views.OrderManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление заказами" Height="500" Width="900"
        Background="{StaticResource PrimaryBackgroundBrush}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        
        <TextBlock Grid.Row="0" Text="Управление заказами" 
                  Style="{StaticResource HeaderTextStyle}"
                  HorizontalAlignment="Center" Margin="0,0,0,10"/>

        
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="btnAdd" Content="Добавить заказ" Click="BtnAdd_Click"
                    Style="{StaticResource AccentButtonStyle}"/>
            <Button x:Name="btnEdit" Content="Изменить статус" Click="BtnEdit_Click"
                    Style="{StaticResource AccentButtonStyle}"/>
            <Button x:Name="btnDelete" Content="Удалить заказ" Click="BtnDelete_Click"
                    Style="{StaticResource AccentButtonStyle}"/>
        </StackPanel>

        
        <DataGrid x:Name="ordersGrid" Grid.Row="2"
                 AutoGenerateColumns="False"
                 IsReadOnly="True"
                 SelectionMode="Single"
                 Background="{StaticResource PrimaryBackgroundBrush}"
                 FontFamily="{StaticResource MainFont}"
                 FontSize="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="ID пользователя" Binding="{Binding UserId}" Width="100"/>
                <DataGridTextColumn Header="ID книги" Binding="{Binding BookId}" Width="80"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="80"/>
                <DataGridTextColumn Header="Дата заказа" Binding="{Binding OrderDate, StringFormat={}{0:dd.MM.yyyy}}" Width="120"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        
        <TextBlock Grid.Row="3" x:Name="txtStatus" Margin="0,5" FontStyle="Italic"/>
    </Grid>
</Window>
